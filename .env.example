# --- GitHub App identity (registration is a future, gated step) ---
# Numeric App ID from the App's settings page.
GITHUB_APP_ID=
# PEM private key: provide the file path (preferred) OR the inline key.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
# Webhook secret set on the App; used to verify X-Hub-Signature-256.
GITHUB_WEBHOOK_SECRET=

# --- Server ---
PORT=8932

# --- Store ---
# JSON store shared by the server and the sweep/digest cron processes.
# Default: ./data/store.json
JANITOR_STORE=

# --- State machine thresholds (calendar days; defaults shown) ---
JANITOR_AGING_DAYS=14
JANITOR_ESCALATE_DAYS=30
JANITOR_CRITICAL_DAYS=60
JANITOR_FAILING_GRACE_DAYS=3
